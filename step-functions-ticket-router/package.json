{
  "name": "step-functions-ticket-router",
  "version": "0.1.0",
  "description": "Support-ticket router on AWS Step Functions, comparing the OpenAI Decisions API with Claude on Amazon Bedrock structured outputs.",
  "license": "MIT-0",
  "private": true,
  "bin": {
    "step-functions-ticket-router": "bin/step-functions-ticket-router.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all",
    "compare": "ts-node scripts/compare.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@eslint/js": "^9.39.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1000.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "esbuild": "^0.25.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.2",
    "@anthropic-ai/sdk": "^0.131.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.0",
    "openai": "^7.30.0",
    "zod": "^4.1.0"
  }
}
