{
  "name": "serverless-mcp-server-cdk",
  "version": "0.1.0",
  "description": "A serverless Model Context Protocol (MCP) server on AWS Lambda, deployed with the AWS CDK.",
  "license": "MIT-0",
  "private": true,
  "bin": {
    "serverless-mcp-server-cdk": "bin/serverless-mcp-server-cdk.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1000.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "esbuild": "^0.25.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.0"
  }
}
